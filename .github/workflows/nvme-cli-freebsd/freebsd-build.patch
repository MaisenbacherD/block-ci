FreeBSD build fixes for nvme-cli master, applied by nvme-cli-freebsd.yml.
Regenerate with 'git diff' from a patched nvme-cli tree, and drop this file
once nvme-cli builds on FreeBSD without it.

diff --git a/libnvme/src/meson.build b/libnvme/src/meson.build
index 0e5c1def..030e99b3 100644
--- a/libnvme/src/meson.build
+++ b/libnvme/src/meson.build
@@ -14,7 +14,7 @@ sources = [
     'nvme/tree.c',
     'nvme/util.c',
 ]
-if host_system == 'linux'
+if host_system in ['linux', 'freebsd']
     sources += [
         'nvme/attr-accessors-custom-linux.c',
         'nvme/ioctl-linux.c',
diff --git a/libnvme/src/nvme/ioctl-linux.c b/libnvme/src/nvme/ioctl-linux.c
index 8eb19b85..95d93432 100644
--- a/libnvme/src/nvme/ioctl-linux.c
+++ b/libnvme/src/nvme/ioctl-linux.c
@@ -13,7 +13,9 @@
 #include <string.h>
 #include <unistd.h>
 
+#if defined(__linux__)
 #include <linux/fs.h>
+#endif
 
 #include <sys/ioctl.h>
 #include <sys/stat.h>
@@ -102,6 +104,7 @@ __shr_public int libnvme_get_nsid(
 __shr_public int libnvme_update_block_size(
 		struct libnvme_transport_handle *hdl, int block_size)
 {
+#if defined(BLKBSZSET) && defined(BLKRRPART)
 	int ret;
 	libnvme_fd_t fd = libnvme_transport_handle_get_fd(hdl);
 
@@ -114,6 +117,12 @@ __shr_public int libnvme_update_block_size(
 		return -errno;
 
 	return 0;
+#else
+	/* BLKBSZSET and BLKRRPART are Linux block device ioctls. */
+	(void)hdl;
+	(void)block_size;
+	return -ENOTSUP;
+#endif
 }
 
